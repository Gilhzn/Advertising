{
  "name": "@adv/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "tick": "tsx src/tick.ts",
    "tick:built": "node dist/tick.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adv/agents": "workspace:*",
    "@adv/analytics": "workspace:*",
    "@adv/connectors": "workspace:*",
    "@adv/db": "workspace:*",
    "@adv/email": "workspace:*",
    "@adv/jobs": "workspace:*",
    "@adv/media": "workspace:*",
    "@adv/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "cron-parser": "^5.10.0",
    "dotenv": "^16.4.5",
    "pg-boss": "^12.31.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
