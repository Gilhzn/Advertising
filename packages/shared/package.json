{
  "name": "@adv/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pinned-fetch": {
      "types": "./dist/pinned-fetch.d.ts",
      "default": "./dist/pinned-fetch.js"
    },
    "./ip-guard": {
      "types": "./dist/ip-guard.d.ts",
      "default": "./dist/ip-guard.js"
    }
