# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://adv:adv@localhost:5432/adv
APP_URL=http://localhost:3000
# 32-byte hex key for AES-256-GCM encryption of OAuth tokens: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=

# ---- Claude ----
ANTHROPIC_API_KEY=
# Optional override for the runtime supervisor (default claude-opus-5). e.g. claude-fable-5-1
SUPERVISOR_MODEL=
# Monthly AI spend cap per business (USD)
AI_MONTHLY_BUDGET_USD=50

# ---- Auth (Auth.js) ----
AUTH_SECRET=
AUTH_EMAIL_FROM=login@example.com

# ---- Media storage (Cloudflare R2 / S3 compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adv-media
R2_PUBLIC_BASE_URL=

# ---- Business email ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
EMAIL_PROVIDER=cloudflare_routing   # cloudflare_routing | migadu
MIGADU_ADMIN_EMAIL=
MIGADU_API_KEY=
RESEND_API_KEY=

# ---- Product analytics ----
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_ORG_ID=

# ---- Platform apps (wave 1) ----
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ---- Platform apps (wave 2) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ---- Optional ----
LATE_API_KEY=                 # aggregator fallback (feature flag)
IMAGE_GEN_PROVIDER=none       # none | openai | fal
IMAGE_GEN_API_KEY=
