# ---- Core ----
NODE_ENV=development
DATABASE_URL=postgres://adv:adv@localhost:5432/adv
APP_URL=http://localhost:3000
# 32-byte hex key for AES-256-GCM encryption of OAuth tokens: `openssl rand -hex 32`
TOKEN_ENCRYPTION_KEY=
# Optional, only during a key rotation: the PREVIOUS key, so already-stored tokens and mailbox
# passwords still decrypt. Drop it once every row has been re-encrypted under the new key.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ---- Claude ----
ANTHROPIC_API_KEY=
# Optional override for the runtime supervisor (default claude-opus-5). e.g. claude-fable-5-1
SUPERVISOR_MODEL=
# Monthly AI spend cap per business (USD)
AI_MONTHLY_BUDGET_USD=50

# ---- Auth (Auth.js) ----
AUTH_SECRET=
AUTH_EMAIL_FROM=login@example.com
# Dev-only password-less login provider. Never set in production (ignored when NODE_ENV=production).
ENABLE_DEV_LOGIN=1

# ---- Production login ----
# Owner-password sign-in (works from anywhere, no email provider required). Set OWNER_EMAIL plus
# one of the two below.
OWNER_EMAIL=
OWNER_PASSWORD_HASH=   # pnpm owner:hash '<password>'
# OWNER_PASSWORD=  (plain alternative, not recommended)

# ---- Media storage (Cloudflare R2 / S3 compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=adv-media
R2_PUBLIC_BASE_URL=
# Local fallback directory when R2 is not configured (served at ${APP_URL}/uploads). Ephemeral on Railway.
MEDIA_LOCAL_DIR=
# Vercel Blob (auto-injected when a Blob store is connected); used when R2_* is not set
BLOB_READ_WRITE_TOKEN=

# ---- Business email ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
EMAIL_PROVIDER=cloudflare_routing   # cloudflare_routing | migadu
MIGADU_ADMIN_EMAIL=
MIGADU_API_KEY=
RESEND_API_KEY=

# ---- Product analytics ----
POSTHOG_HOST=https://us.posthog.com
POSTHOG_PERSONAL_API_KEY=
POSTHOG_ORG_ID=

# ---- Platform apps (wave 1) ----
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v22.0          # optional override
META_LOGIN_CONFIG_ID=             # optional: Facebook Login for Business config id
THREADS_APP_ID=                   # Threads uses its own app credentials (not META_APP_*)
THREADS_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202505       # optional; LinkedIn keeps a rolling window of versions
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=            # shown in the wizard ("add @bot as admin")
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# ---- Platform apps (wave 2) ----
X_CLIENT_ID=
X_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# ---- App improvement PRs (Phase 6b, opt-in) ----
# Fine-grained token with contents:write + pull_requests:write on the promoted app's repo only.
GITHUB_TOKEN=

# ---- Optional ----
LATE_API_KEY=                 # aggregator fallback (feature flag)
IMAGE_GEN_PROVIDER=none       # none | openai (gpt-image-1) | fal (flux/schnell)
# API key for whichever IMAGE_GEN_PROVIDER is set above. Enables the visual-director's generate_image
# engine tool for photographic/illustrative hero visuals; render_image (branded template cards) always
# works regardless of this setting. Never logged.
IMAGE_GEN_API_KEY=
